    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "# --- Defensive column detection ---\n",
    "DATE_COL = 'date' if 'date' in hmm_df.columns else ('Date' if 'Date' in hmm_df.columns else None)\n",
    "if DATE_COL is None:\n",
    "    if isinstance(hmm_df.index, pd.DatetimeIndex):\n",
    "        plot_df = hmm_df.copy()\n",
    "        plot_df['__date__'] = hmm_df.index\n",
    "        DATE_COL = '__date__'\n",
    "    else:\n",
    "        raise ValueError(\"No date column found (expected 'date' or 'Date') and index is not DatetimeIndex\")\n",
    "else:\n",
    "    plot_df = hmm_df.copy()\n",
    "    plot_df[DATE_COL] = pd.to_datetime(plot_df[DATE_COL])\n",
    "\n",
    "# Prefer a volatility-like column for overlay\n",
    "candidate_vol_cols = [c for c in plot_df.columns if any(k in c.lower() for k in ['rv', 'vol', 'realized', 'sigma', 'vix'])]\n",
    "VOL_COL = None\n",
    "if candidate_vol_cols:\n",
    "    # prioritize common ones\n",
    "    prefs = ['rv_10', 'rv_5', 'rv_20', 'realized_vol', 'volatility', 'vix']\n",
    "    for p in prefs:\n",
    "        for c in candidate_vol_cols:\n",
    "            if p in c.lower():\n",
    "                VOL_COL = c\n",
    "                break\n",
    "        if VOL_COL:\n",
    "            break\n",
    "    if VOL_COL is None:\n",
    "        VOL_COL = candidate_vol_cols[0]\n",
    "\n",
    "# If still none, fall back to first obs col\n",
    "if VOL_COL is None:\n",
    "    if len(OBS_COLS) == 0:\n",
    "        raise ValueError('Could not infer a volatility/observation column to plot.')\n",
    "    VOL_COL = OBS_COLS[0]\n",
    "\n",
    "# Order states by average VOL_COL (calm -> turbulent)\n",
    "state_order = plot_df.groupby('hmm_state')[VOL_COL].mean().sort_values().index.tolist()\n",
    "state_map = {old:i for i, old in enumerate(state_order)}\n",
    "plot_df['hmm_state_ord'] = plot_df['hmm_state'].map(state_map)\n",
    "\n",
    "plt.figure(figsize=(12,4))\n",
    "plt.plot(plot_df[DATE_COL], plot_df[VOL_COL], linewidth=1)\n",
    "plt.scatter(plot_df[DATE_COL], plot_df[VOL_COL], c=plot_df['hmm_state_ord'], s=8)\n",
    "plt.title(f\"HMM States Overlay on {VOL_COL}\")\n",
    "plt.xlabel('Date')\n",
    "plt.ylabel(VOL_COL)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
  ]
