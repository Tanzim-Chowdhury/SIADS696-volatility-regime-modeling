    "    print(f\"\\n=== {model_name} ===\")\n",
    "    print(\"VAL  | acc:\", round(m[\"val\"][\"accuracy\"], 4), \"macro_f1:\", round(m[\"val\"][\"macro_f1\"], 4))\n",
