    "from src.pipeline.train import SplitSpec, train_baselines_3way\n",
    "\n",
    "split = SplitSpec(\n",
    "    train_end=TRAIN_END,\n",
    "    val_start=VAL_START,\n",
    "    val_end=VAL_END,\n",
    "    test_start=TEST_START,\n",
    ")\n",
