# HMM Visualization Cells

## Cell 1 (Regime timeline)
```python
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# Reorder states by average volatility
VOL_COL = "rv_10"
plot_df = hmm_df.copy()
plot_df["date"] = pd.to_datetime(plot_df["date"])

state_order = (
    plot_df.groupby("hmm_state")[VOL_COL].mean()
    .sort_values()
    .index.tolist()
)
state_map = {old: i for i, old in enumerate(state_order)}
plot_df["hmm_state_ord"] = plot_df["hmm_state"].map(state_map)

plt.figure(figsize=(12, 4))
plt.plot(plot_df["date"], plot_df[VOL_COL], linewidth=1)
plt.scatter(plot_df["date"], plot_df[VOL_COL], c=plot_df["hmm_state_ord"], s=8, cmap="viridis")
plt.title(f"HMM States Overlayed on {VOL_COL} ({TICKER_FOR_HMM})")
plt.xlabel("Date")
plt.ylabel(VOL_COL)
plt.tight_layout()
plt.show()
```

## Cell 2 (Transition matrix heatmap)
```python
import matplotlib.pyplot as plt
import numpy as np

T = hmm.transmat_.copy()

plt.figure(figsize=(4.8, 4))
plt.imshow(T, cmap="Blues")
plt.title("HMM Transition Matrix")
plt.xlabel("To state")
plt.ylabel("From state")

for (i, j), v in np.ndenumerate(T):
    plt.text(j, i, f"{v:.2f}", ha="center", va="center", color="black")

plt.xticks(range(N_STATES))
plt.yticks(range(N_STATES))
plt.colorbar()
plt.tight_layout()
plt.show()
```

## Cell 3 (State profiles)
```python
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Mean of OBS_COLS per ordered state
prof = (
    plot_df.groupby("hmm_state_ord")[OBS_COLS]
    .mean()
    .sort_index()
)

display(prof)

# Bar plot for each OBS_COL
plt.figure(figsize=(10, 4))
x = np.arange(len(prof.index))
width = 0.25

for k, col in enumerate(OBS_COLS):
    plt.bar(x + (k - 1) * width, prof[col].values, width=width, label=col)

plt.xticks(x, [f"state {i}" for i in prof.index])
plt.title("HMM State Profiles (Mean of Observations)")
plt.xlabel("State")
plt.ylabel("Mean value")
plt.legend()
plt.tight_layout()
plt.show()
```
